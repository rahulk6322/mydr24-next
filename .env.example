# Public site config (inlined into the client bundle at build time)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_HELPLINE_TEL=+910000000024
NEXT_PUBLIC_HELPLINE_DISPLAY="+91 00000 00024"
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_CONTACT_EMAIL=care@mydr24.in
NEXT_PUBLIC_GRIEVANCE_EMAIL=grievance@mydr24.in
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=

# Lead storage (server only)
# JSON file for local/self-hosted use. On read-only hosts (e.g. Vercel) leads fall back to memory: set a webhook.
LEADS_FILE=.data/leads.json
# Optional: every lead is POSTed here as JSON (CRM, Zapier, Google Apps Script, Slack, etc.)
LEADS_WEBHOOK_URL=

# Admin (/admin/leads, /api/admin/leads). Admin is disabled (404) when ADMIN_PASSWORD is empty.
ADMIN_USER=admin
ADMIN_PASSWORD=
